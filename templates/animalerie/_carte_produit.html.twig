{% import 'animalerie/_macros.html.twig' as m %}
<article class="carte">
    {% if produit.prixPromo %}<span class="carte__promo">Promo</span>{% endif %}
    <button class="carte__coeur" type="button" aria-label="Ajouter aux favoris">{{ m.icone('heart') }}</button>

    <div class="carte__visuel{{ produit.image and 'packshots' in produit.image ? ' carte__visuel--packshot' }}">
        {% if produit.image %}
            <img src="{{ asset(produit.image) }}" alt="{{ produit.nom }}" loading="lazy">
        {% else %}
            {{ m.univers(produit.categorie.univers.slug, 'ico--xl') }}
        {% endif %}
    </div>

    <h3 class="carte__nom">{{ produit.nom }}</h3>
    <p class="carte__desc">{{ produit.description }}</p>

    <p class="carte__prix">
        <strong>{{ m.prix(produit.prixActuel) }}</strong>
        {% if produit.prixPromo %}<s>{{ m.prix(produit.prix) }}</s>{% endif %}
    </p>

    {% if produit.stock > 0 %}
        <form method="post" action="{{ path('app_panier_ajouter', {id: produit.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('panier') }}">
            <button class="btn btn--block" type="submit">{{ m.icone('shopping-cart') }} Ajouter au panier</button>
        </form>
    {% else %}
        <button class="btn btn--block" type="button" disabled>Rupture de stock</button>
    {% endif %}
</article>
