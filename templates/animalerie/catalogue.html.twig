{% extends 'animalerie/base.html.twig' %}

{% block title %}{{ categorie ? categorie.nom : 'Tous les produits' }} – Animalerie 974{% endblock %}

{% block body %}
{% import 'animalerie/_macros.html.twig' as m %}

<p class="fil">
    <a href="{{ path('app_accueil') }}">Accueil</a> ›
    {% if categorie and categorie.parent %}
        <a href="{{ path('app_catalogue', {slug: categorie.parent.slug}) }}">{{ categorie.parent.nom|split(' (')[0] }}</a> ›
    {% endif %}
    {{ categorie ? categorie.nom : 'Tous les produits' }}
</p>

{% if categorie %}
    <section class="banniere">
        {% if categorie.image %}<img src="{{ asset(categorie.image) }}" alt="">{% endif %}
        <div class="banniere__texte">
            <span class="pastille">{{ m.univers(categorie.univers.slug) }} {{ categorie.univers.nom|split(' (')[0] }}</span>
            <h1>{{ categorie.nom }}</h1>
            <span class="compteur">{{ produits|length }} produit{{ produits|length > 1 ? 's' }}</span>
        </div>
    </section>

    {% if animaux %}
        <nav class="puces" aria-label="Animaux">
            <a class="{{ categorie.parent is null ? 'is-active' }}" href="{{ path('app_catalogue', {slug: categorie.univers.slug}) }}">Tous</a>
            {% for a in animaux %}
                <a class="{{ categorie.id == a.id ? 'is-active' }}" href="{{ path('app_catalogue', {slug: a.slug}) }}">
                    {% if a.image %}<img src="{{ asset(a.image) }}" alt="">{% endif %}{{ a.nom }}
                </a>
            {% endfor %}
        </nav>
    {% endif %}
{% else %}
    <div class="titre-ligne">
        <h1>Tous les produits</h1>
        <span class="compteur">{{ produits|length }} produit{{ produits|length > 1 ? 's' }}</span>
    </div>
{% endif %}

{% if recherche %}
    <p>Résultats pour « <strong>{{ recherche }}</strong> » – <a href="{{ path('app_catalogue', {slug: categorie.slug ?? null}) }}">effacer</a></p>
{% endif %}

{% if produits is empty %}
    <p class="vide">Aucun produit ne correspond à votre recherche.</p>
{% else %}
    <div class="produits-grille">
        {% for produit in produits %}
            {% include 'animalerie/_carte_produit.html.twig' %}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
