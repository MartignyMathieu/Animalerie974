{% extends 'animalerie/base.html.twig' %}

{% block title %}Mon compte – Animalerie 974{% endblock %}

{% block body %}
{% import 'animalerie/_macros.html.twig' as m %}

<p class="fil"><a href="{{ path('app_accueil') }}">Accueil</a> › Mon compte</p>

<div class="titre-ligne">
    <h1>Bonjour {{ app.user.prenom }}</h1>
</div>

<div class="compte">
    <section class="compte__carte">
        <h2>{{ m.icone('user') }} Mes informations</h2>
        <dl>
            <dt>Nom</dt><dd>{{ app.user.nom }}</dd>
            <dt>E-mail</dt><dd>{{ app.user.email }}</dd>
            <dt>Membre depuis le</dt><dd>{{ app.user.creeLe|date('d/m/Y') }}</dd>
        </dl>
        <a class="btn btn--clair" href="{{ path('app_deconnexion') }}">Se déconnecter</a>
    </section>

    <section class="compte__carte">
        <h2>{{ m.icone('shopping-cart') }} Mon panier</h2>
        {% if panier and panier.lignes|length %}
            <p>{{ panier.nbArticles }} article{{ panier.nbArticles > 1 ? 's' }} pour un total de <strong>{{ m.prix(panier.total) }}</strong>.</p>
            <a class="btn" href="{{ path('app_panier') }}">Voir mon panier {{ m.icone('arrow-right') }}</a>
        {% else %}
            <p>Votre panier est vide.</p>
            <a class="btn" href="{{ path('app_catalogue') }}">Découvrir nos produits {{ m.icone('arrow-right') }}</a>
        {% endif %}
    </section>

    <section class="compte__carte">
        <h2>{{ m.icone('question') }} Besoin d'aide ?</h2>
        <p>Consultez la FAQ ou écrivez-nous, nous vous répondons rapidement.</p>
        <a class="btn btn--clair" href="{{ path('app_aide') }}">Aller à l'aide</a>
    </section>
</div>
{% endblock %}
